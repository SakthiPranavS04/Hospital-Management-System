# Local Development Environment Variables
# Copy this to .env in hospital-backend/ directory for local testing

# Get your Supabase connection string from:
# Supabase Dashboard → Project Settings → Database → Connection String (Standard)
DATABASE_URL=postgresql://user:password@db.xxxxx.supabase.co:5432/postgres

# Frontend URL (for CORS in local dev, keep as localhost)
FRONTEND_URL=http://localhost:5173

# Environment
NODE_ENV=development

# Port
PORT=3001
